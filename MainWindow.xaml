<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Amazon Search"
    Height="650"
    Width="1200"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 検索窓 -->
        <TextBox
            x:Name="SearchBox"
            Grid.Row="0"
            Height="35"
            FontSize="16"
            Padding="8,4"
            Margin="0,0,0,10" />

        <!-- 検索ボタン -->
        <Button
            x:Name="SearchButton"
            Grid.Row="1"
            Height="35"
            Content="Search"
            FontSize="14"
            Margin="0,0,0,10" />

        <!-- 検索結果 -->
        <DataGrid
            x:Name="ResultGrid"
            Grid.Row="2"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False"
            SelectionMode="Single"
            RowHeight="110">

            <DataGrid.Columns>

                <!-- 表紙画像 -->
                <DataGridTemplateColumn
                    Header="Cover"
                    Width="90">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Image
                                Source="{Binding ImageURL}"
                                Width="70"
                                Height="100"
                                Stretch="Uniform"
                                Margin="5" />

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>


                <!-- タイトル -->
                <DataGridTextColumn
                    Header="Title"
                    Binding="{Binding Title}"
                    Width="*" />

                <!-- 著者 -->
                <DataGridTextColumn
                    Header="Author"
                    Binding="{Binding Author}"
                    Width="150" />

                <!-- 発売日 -->
                <DataGridTextColumn
                    Header="Publication Date"
                    Binding="{Binding PublicationDate}"
                    Width="130" />

                <!-- ASIN -->
                <DataGridTextColumn
                    Header="ASIN"
                    Binding="{Binding ASIN}"
                    Width="110" />

                <!-- Amazon URL -->
                <DataGridTextColumn
                    Header="Amazon URL"
                    Binding="{Binding URL}"
                    Width="250" />

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>