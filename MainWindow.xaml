<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Amazon Search"
    Height="500"
    Width="900"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="0"
            Height="35"
            FontSize="16"
            Padding="8,4"
            Margin="0,0,0,10" />

        <Button
            x:Name="SearchButton"
            Grid.Row="1"
            Height="35"
            Content="Search"
            FontSize="14"
            Margin="0,0,0,10" />

        <DataGrid
            x:Name="ResultGrid"
            Grid.Row="2"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserAddRows="False"
            SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Title"
                    Binding="{Binding Title}"
                    Width="*" />

                <DataGridTextColumn
                    Header="ASIN"
                    Binding="{Binding ASIN}"
                    Width="130" />

                <DataGridTextColumn
                    Header="Amazon URL"
                    Binding="{Binding URL}"
                    Width="300" />

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>