<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Amazon Media Search"
    Height="700"
    Width="1200"
    MinHeight="500"
    MinWidth="900"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F5">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,20">

            <TextBlock
                Text="Amazon Media Search"
                FontSize="26"
                FontWeight="Bold"
                Foreground="#222222" />

            <TextBlock
                Text="Amazon Creators API 商品検索"
                FontSize="13"
                Foreground="#666666"
                Margin="0,4,0,0" />

        </StackPanel>


        <Border
            Grid.Row="1"
            Background="White"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>


                <ComboBox
                    x:Name="CategoryBox"
                    Grid.Column="0"
                    Height="38"
                    Margin="0,0,10,0"
                    FontSize="14"
                    SelectedIndex="0"
                    VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Books"/>
                    <ComboBoxItem Content="Kindle"/>
                    <ComboBoxItem Content="Movies"/>
                    <ComboBoxItem Content="Audible"/>

                </ComboBox>


                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Height="38"
                    FontSize="16"
                    Padding="10,5"
                    Margin="0,0,10,0"
                    VerticalContentAlignment="Center" />


                <ComboBox
                    x:Name="SortBox"
                    Grid.Column="2"
                    Width="160"
                    Height="38"
                    Margin="0,0,10,0"
                    FontSize="13"
                    SelectedIndex="0"
                    VerticalContentAlignment="Center">

                    <ComboBoxItem
                        Content="関連度順"
                        Tag="Relevance" />

                    <ComboBoxItem
                        Content="新着順"
                        Tag="NewestArrivals" />

                    <ComboBoxItem
                        Content="価格が安い順"
                        Tag="Price:LowToHigh" />

                    <ComboBoxItem
                        Content="価格が高い順"
                        Tag="Price:HighToLow" />

                </ComboBox>


                <ComboBox
                    x:Name="FilterBox"
                    Grid.Column="3"
                    Width="150"
                    Height="38"
                    Margin="0,0,10,0"
                    FontSize="13"
                    SelectedIndex="0"
                    VerticalContentAlignment="Center">

                    <ComboBoxItem
                        Content="すべて"
                        Tag="All" />

                    <ComboBoxItem
                        Content="発売済み"
                        Tag="Released" />

                    <ComboBoxItem
                        Content="予約のみ"
                        Tag="Preorder" />

                    <ComboBoxItem
                        x:Name="IncludedFilterItem"
                        Content="追加料金なし"
                        Tag="Included"
                        Visibility="Collapsed" />

                </ComboBox>


                <Button
                    x:Name="SearchButton"
                    Grid.Column="4"
                    Height="38"
                    Content="Search"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand" />

            </Grid>

        </Border>


        <Grid
            Grid.Row="2"
            Margin="0,0,0,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="検索結果"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#333333"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                Text=""
                FontSize="13"
                Foreground="#666666"
                VerticalAlignment="Center" />

        </Grid>


        <Grid Grid.Row="3">


            <!-- Books -->
            <Border
                x:Name="BooksGridBorder"
                Background="White"
                CornerRadius="8"
                Padding="1">

                <DataGrid
                    x:Name="BooksGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    MinRowHeight="140"
                    HeadersVisibility="None"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    AlternatingRowBackground="#FAFAFA">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image
                                        Source="{Binding ImageURL}"
                                        Width="80"
                                        Height="115"
                                        Stretch="Uniform"
                                        Margin="8" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Grid Margin="10,8">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Text="{Binding Title}"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Foreground="#222222"
                                            TextWrapping="Wrap" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding Author}"
                                            FontSize="14"
                                            Foreground="#444444"
                                            Margin="0,5,0,0" />


                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{Binding Publisher}"
                                            FontSize="12"
                                            Foreground="#777777"
                                            Margin="0,4,0,0" />


                                        <StackPanel
                                            Grid.Row="3"
                                            Orientation="Horizontal"
                                            Margin="0,5,0,0">

                                            <TextBlock
                                                Text="{Binding ReleaseDate}"
                                                FontSize="12"
                                                Foreground="#777777" />

                                            <TextBlock
                                                Text="  ・  "
                                                Foreground="#999999" />

                                            <TextBlock
                                                Text="{Binding Format}"
                                                FontSize="12"
                                                Foreground="#777777" />

                                            <TextBlock
                                                Text="  ・  ASIN: "
                                                Foreground="#999999" />

                                            <TextBlock
                                                Text="{Binding ASIN}"
                                                FontSize="12"
                                                Foreground="#777777" />

                                        </StackPanel>


                                        <StackPanel
                                            Grid.Row="4"
                                            Orientation="Horizontal"
                                            Margin="0,4,0,0">

                                            <TextBlock
                                                Text="{Binding PriceStatus}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#333333" />

                                            <TextBlock Text="  "/>

                                            <TextBlock
                                                Text="{Binding Price}"
                                                FontSize="13"
                                                Foreground="#666666" />

                                        </StackPanel>

                                    </Grid>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Button
                                        Content="Amazonで開く"
                                        Tag="{Binding URL}"
                                        Padding="12,8"
                                        Margin="10"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>


            <!-- Kindle -->
            <Border
                x:Name="KindleGridBorder"
                Background="White"
                CornerRadius="8"
                Padding="1"
                Visibility="Collapsed">

                <DataGrid
                    x:Name="KindleGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    MinRowHeight="140"
                    HeadersVisibility="None"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    AlternatingRowBackground="#FAFAFA">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Image
                                        Source="{Binding ImageURL}"
                                        Width="80"
                                        Height="115"
                                        Stretch="Uniform"
                                        Margin="8" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Grid Margin="10,8">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Text="{Binding Title}"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Foreground="#222222"
                                            TextWrapping="Wrap" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding Author}"
                                            FontSize="14"
                                            Foreground="#444444"
                                            Margin="0,5,0,0" />


                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{Binding Publisher}"
                                            FontSize="12"
                                            Foreground="#777777"
                                            Margin="0,4,0,0" />


                                        <StackPanel
                                            Grid.Row="3"
                                            Orientation="Horizontal"
                                            Margin="0,5,0,0">

                                            <TextBlock
                                                Text="{Binding ReleaseDate}"
                                                FontSize="12"
                                                Foreground="#777777" />

                                            <TextBlock
                                                Text="  ・  "
                                                Foreground="#999999" />

                                            <TextBlock
                                                Text="{Binding Format}"
                                                FontSize="12"
                                                Foreground="#777777" />

                                            <TextBlock
                                                Text="  ・  ASIN: "
                                                Foreground="#999999" />

                                            <TextBlock
                                                Text="{Binding ASIN}"
                                                FontSize="12"
                                                Foreground="#777777" />

                                        </StackPanel>


                                        <StackPanel
                                            Grid.Row="4"
                                            Orientation="Horizontal"
                                            Margin="0,4,0,0">

                                            <TextBlock
                                                Text="{Binding PriceStatus}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="#333333" />

                                            <TextBlock Text="  "/>

                                            <TextBlock
                                                Text="{Binding Price}"
                                                FontSize="13"
                                                Foreground="#666666" />

                                        </StackPanel>

                                    </Grid>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Button
                                        Content="Amazonで開く"
                                        Tag="{Binding URL}"
                                        Padding="12,8"
                                        Margin="10"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>


            <!-- Movies legacy grid -->
            <Border
                x:Name="ResultGridBorder"
                Background="White"
                CornerRadius="8"
                Padding="1"
                Visibility="Collapsed">

                <DataGrid
                    x:Name="ResultGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    RowHeight="120"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    AlternatingRowBackground="#FAFAFA">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="Image" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image
                                        Source="{Binding ImageURL}"
                                        Width="75"
                                        Height="105"
                                        Stretch="Uniform"
                                        Margin="8" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Header="Title"
                            Binding="{Binding Title}"
                            Width="*" />

                        <DataGridTextColumn
                            Header="Creator"
                            Binding="{Binding Creator}"
                            Width="200" />

                        <DataGridTextColumn
                            Header="Release Date"
                            Binding="{Binding ReleaseDate}"
                            Width="140" />

                        <DataGridTextColumn
                            Header="ASIN"
                            Binding="{Binding ASIN}"
                            Width="120" />

                        <DataGridTemplateColumn Header="Amazon" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Button
                                        Content="Amazonで開く"
                                        Tag="{Binding URL}"
                                        Padding="10,6"
                                        Margin="8"
                                        Cursor="Hand"
                                        VerticalAlignment="Center" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>


            <!-- Audible -->
            <Border
                x:Name="AudibleGridBorder"
                Background="White"
                CornerRadius="8"
                Padding="1"
                Visibility="Collapsed">

                <DataGrid
                    x:Name="AudibleGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    MinRowHeight="140"
                    HeadersVisibility="None"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    AlternatingRowBackground="#FAFAFA">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Image
                                        Source="{Binding ImageURL}"
                                        Width="80"
                                        Height="115"
                                        Stretch="Uniform"
                                        Margin="8" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Grid Margin="10,8">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>


                                        <TextBlock
                                            Grid.Row="0"
                                            Text="{Binding Title}"
                                            FontSize="17"
                                            FontWeight="Bold"
                                            Foreground="#222222"
                                            TextWrapping="Wrap" />


                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding Author}"
                                            FontSize="14"
                                            Foreground="#444444"
                                            Margin="0,5,0,0" />


                                        <StackPanel
                                            Grid.Row="2"
                                            Orientation="Horizontal"
                                            Margin="0,4,0,0">

                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Visible" />

                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding Narrator}"
                                                            Value="">

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBlock
                                                Text="ナレーション: "
                                                FontSize="13"
                                                Foreground="#666666" />

                                            <TextBlock
                                                Text="{Binding Narrator}"
                                                FontSize="13"
                                                Foreground="#444444" />

                                        </StackPanel>


                                        <TextBlock
                                            Grid.Row="3"
                                            Text="{Binding Publisher}"
                                            FontSize="12"
                                            Foreground="#777777"
                                            Margin="0,4,0,0" />


                                        <StackPanel
                                            Grid.Row="4"
                                            Margin="0,5,0,0">

                                            <StackPanel Orientation="Horizontal">

                                                <TextBlock
                                                    Text="{Binding ReleaseDate}"
                                                    FontSize="12"
                                                    Foreground="#777777" />

                                                <TextBlock
                                                    Text="  ・  "
                                                    Foreground="#999999" />

                                                <TextBlock
                                                    Text="{Binding Format}"
                                                    FontSize="12"
                                                    Foreground="#777777" />

                                                <TextBlock
                                                    Text="  ・  ASIN: "
                                                    Foreground="#999999" />

                                                <TextBlock
                                                    Text="{Binding ASIN}"
                                                    FontSize="12"
                                                    Foreground="#777777" />

                                            </StackPanel>


                                            <StackPanel
                                                Orientation="Horizontal"
                                                Margin="0,4,0,0">

                                                <TextBlock
                                                    Text="{Binding PriceStatus}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="#333333" />

                                                <TextBlock Text="  "/>

                                                <TextBlock
                                                    Text="{Binding Price}"
                                                    FontSize="13"
                                                    Foreground="#666666" />

                                            </StackPanel>

                                        </StackPanel>

                                    </Grid>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>


                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Button
                                        Content="Amazonで開く"
                                        Tag="{Binding URL}"
                                        Padding="12,8"
                                        Margin="10"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</Window>