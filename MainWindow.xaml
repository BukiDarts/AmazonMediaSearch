<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Amazon Media Search"
    Height="700"
    Width="1200"
    MinHeight="500"
    MinWidth="900"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F5">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,20">

            <TextBlock
                Text="Amazon Media Search"
                FontSize="26"
                FontWeight="Bold"
                Foreground="#222222" />

            <TextBlock
                Text="Amazon Creators API 商品検索"
                FontSize="13"
                Foreground="#666666"
                Margin="0,4,0,0" />

        </StackPanel>

        <Border
            Grid.Row="1"
            Background="White"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="CategoryBox"
                    Grid.Column="0"
                    Height="38"
                    Margin="0,0,10,0"
                    FontSize="14"
                    SelectedIndex="0">

                    <ComboBoxItem Content="Books"/>
                    <ComboBoxItem Content="Kindle"/>
                    <ComboBoxItem Content="Movies"/>
                    <ComboBoxItem Content="Audible"/>

                </ComboBox>

                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Height="38"
                    FontSize="16"
                    Padding="10,5"
                    Margin="0,0,10,0"
                    VerticalContentAlignment="Center" />

                <Button
                    x:Name="SearchButton"
                    Grid.Column="2"
                    Height="38"
                    Content="Search"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand" />

            </Grid>

        </Border>

        <Grid
            Grid.Row="2"
            Margin="0,0,0,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="検索結果"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#333333"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                Text=""
                FontSize="13"
                Foreground="#666666"
                VerticalAlignment="Center" />

        </Grid>

        <Grid Grid.Row="3">

            <!-- Existing grid for Books / Kindle / Movies -->
            <Border
                x:Name="ResultGridBorder"
                Background="White"
                CornerRadius="8"
                Padding="1">

                <DataGrid
                    x:Name="ResultGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    RowHeight="120"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    AlternatingRowBackground="#FAFAFA">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn
                            Header="Image"
                            Width="100">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Image
                                        Source="{Binding ImageURL}"
                                        Width="75"
                                        Height="105"
                                        Stretch="Uniform"
                                        Margin="8" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Header="Title"
                            Binding="{Binding Title}"
                            Width="*" />

                        <DataGridTextColumn
                            Header="Creator"
                            Binding="{Binding Creator}"
                            Width="200" />

                        <DataGridTextColumn
                            Header="Release Date"
                            Binding="{Binding ReleaseDate}"
                            Width="140" />

                        <DataGridTextColumn
                            Header="ASIN"
                            Binding="{Binding ASIN}"
                            Width="120" />

                        <DataGridTemplateColumn
                            Header="Amazon"
                            Width="140">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Button
                                        Content="Amazonで開く"
                                        Tag="{Binding URL}"
                                        Padding="10,6"
                                        Margin="8"
                                        Cursor="Hand"
                                        VerticalAlignment="Center" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- Audible-only grid -->
            <Border
                x:Name="AudibleGridBorder"
                Background="White"
                CornerRadius="8"
                Padding="1"
                Visibility="Collapsed">

                <DataGrid
                    x:Name="AudibleGrid"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    SelectionMode="Single"
                    RowHeight="120"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0"
                    AlternatingRowBackground="#FAFAFA">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn
                            Header="Image"
                            Width="100">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Image
                                        Source="{Binding ImageURL}"
                                        Width="75"
                                        Height="105"
                                        Stretch="Uniform"
                                        Margin="8" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Header="Title"
                            Binding="{Binding Title}"
                            Width="*" />

                        <DataGridTextColumn
                            Header="Author"
                            Binding="{Binding Author}"
                            Width="160" />

                        <DataGridTextColumn
                            Header="Narrator"
                            Binding="{Binding Narrator}"
                            Width="160" />

                        <DataGridTextColumn
                            Header="Publisher"
                            Binding="{Binding Publisher}"
                            Width="190" />

                        <DataGridTextColumn
                            Header="Format"
                            Binding="{Binding Format}"
                            Width="100" />

                        <DataGridTextColumn
                            Header="Release Date"
                            Binding="{Binding ReleaseDate}"
                            Width="150" />

                        <DataGridTextColumn
                            Header="ASIN"
                            Binding="{Binding ASIN}"
                            Width="120" />

                        <DataGridTemplateColumn
                            Header="Amazon"
                            Width="140">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Button
                                        Content="Amazonで開く"
                                        Tag="{Binding URL}"
                                        Padding="10,6"
                                        Margin="8"
                                        Cursor="Hand"
                                        VerticalAlignment="Center" />

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </Grid>

    </Grid>

</Window>