<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Amazon Media Search"
    Height="700"
    Width="1200"
    MinHeight="500"
    MinWidth="900"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F5">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,20">

            <TextBlock
                Text="Amazon Media Search"
                FontSize="26"
                FontWeight="Bold"
                Foreground="#222222" />

            <TextBlock
                Text="Amazon Creators API 商品検索"
                FontSize="13"
                Foreground="#666666"
                Margin="0,4,0,0" />

        </StackPanel>


        <!-- 検索エリア -->
        <Border
            Grid.Row="1"
            Background="White"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <!-- カテゴリ -->
                <ComboBox
                    x:Name="CategoryBox"
                    Grid.Column="0"
                    Height="38"
                    Margin="0,0,10,0"
                    FontSize="14"
                    SelectedIndex="0">

                    <ComboBoxItem Content="Books"/>
                    <ComboBoxItem Content="Kindle"/>
                    <ComboBoxItem Content="Movies"/>

                </ComboBox>


                <!-- 検索窓 -->
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    Height="38"
                    FontSize="16"
                    Padding="10,5"
                    Margin="0,0,10,0"
                    VerticalContentAlignment="Center" />


                <!-- 検索ボタン -->
                <Button
                    x:Name="SearchButton"
                    Grid.Column="2"
                    Height="38"
                    Content="Search"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand" />

            </Grid>

        </Border>


        <!-- 検索結果見出し -->
        <Grid
            Grid.Row="2"
            Margin="0,0,0,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="検索結果"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#333333"
                VerticalAlignment="Center" />

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                Text=""
                FontSize="13"
                Foreground="#666666"
                VerticalAlignment="Center" />

        </Grid>


        <!-- 検索結果 -->
        <Border
            Grid.Row="3"
            Background="White"
            CornerRadius="8"
            Padding="1">

            <DataGrid
                x:Name="ResultGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionMode="Single"
                RowHeight="120"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                BorderThickness="0"
                AlternatingRowBackground="#FAFAFA">

                <DataGrid.Columns>

                    <!-- 表紙 / パッケージ画像 -->
                    <DataGridTemplateColumn
                        Header="Image"
                        Width="100">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Image
                                    Source="{Binding ImageURL}"
                                    Width="75"
                                    Height="105"
                                    Stretch="Uniform"
                                    Margin="8" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- タイトル -->
                    <DataGridTextColumn
                        Header="Title"
                        Binding="{Binding Title}"
                        Width="*" />


                    <!-- 著者 / 監督 -->
                    <DataGridTextColumn
                        Header="Creator"
                        Binding="{Binding Creator}"
                        Width="180" />


                    <!-- 発売日 -->
                    <DataGridTextColumn
                        Header="Release Date"
                        Binding="{Binding ReleaseDate}"
                        Width="140" />


                    <!-- ASIN -->
                    <DataGridTextColumn
                        Header="ASIN"
                        Binding="{Binding ASIN}"
                        Width="120" />


                    <!-- Amazon -->
                    <DataGridTemplateColumn
                        Header="Amazon"
                        Width="140">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <Button
                                    Content="Amazonで開く"
                                    Tag="{Binding URL}"
                                    Padding="10,6"
                                    Margin="8"
                                    Cursor="Hand"
                                    VerticalAlignment="Center" />

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>