<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="漫画シリーズ情報"
    Width="1050"
    Height="720"
    MinWidth="850"
    MinHeight="580"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search area -->
        <Border
            Grid.Row="0"
            Padding="12"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="ASIN / Amazon URL"/>

                <TextBox
                    x:Name="AsinBox"
                    Grid.Column="1"
                    Height="32"
                    Padding="6,4"
                    VerticalContentAlignment="Center"/>

                <Button
                    x:Name="SearchButton"
                    Grid.Column="2"
                    Width="90"
                    Height="32"
                    Margin="10,0,0,0"
                    Content="検索"/>

                <Button
                    x:Name="RefreshButton"
                    Grid.Column="3"
                    Width="90"
                    Height="32"
                    Margin="8,0,0,0"
                    Content="再取得"/>

            </Grid>

        </Border>

        <!-- Series summary -->
        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="14"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="6">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="130"
                    Height="180"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Background="#F5F5F5">

                    <Image
                        x:Name="CoverImage"
                        Stretch="Uniform"/>

                </Border>

                <Grid
                    Grid.Column="1"
                    Margin="18,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="SeriesTitleText"
                        Grid.Row="0"
                        FontSize="24"
                        FontWeight="Bold"
                        TextWrapping="Wrap"
                        Text="作品名"/>

                    <TextBlock
                        x:Name="VolumeSummaryText"
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="巻数：-"/>

                    <TextBlock
                        x:Name="KUSummaryText"
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Kindle Unlimited：-"/>

                    <TextBlock
                        x:Name="KUCountText"
                        Grid.Row="3"
                        Margin="0,6,0,0"
                        FontSize="14"
                        Foreground="#555555"
                        Text=""/>

                    <TextBlock
                        x:Name="UnknownSummaryText"
                        Grid.Row="4"
                        Margin="0,6,0,0"
                        Foreground="#777777"
                        Text=""/>

                </Grid>

            </Grid>

        </Border>

        <!-- Status -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="2,10,0,8"
            Foreground="#555555"
            Text="ASINまたはAmazon商品URLを入力してください。"/>

        <!-- Volume list -->
        <DataGrid
            x:Name="VolumesGrid"
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            SelectionMode="Single"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal"
            RowHeight="34">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="巻"
                    Binding="{Binding Volume}"
                    Width="60"/>

                <DataGridTextColumn
                    Header="KU"
                    Binding="{Binding KUDisplay}"
                    Width="90"/>

                <DataGridTextColumn
                    Header="価格"
                    Binding="{Binding Price}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="タイトル"
                    Binding="{Binding Title}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="ASIN"
                    Binding="{Binding ASIN}"
                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Request summary -->
        <TextBlock
            x:Name="RequestSummaryText"
            Grid.Row="4"
            Margin="2,8,0,0"
            Foreground="#777777"
            Text=""/>

    </Grid>

</Window>