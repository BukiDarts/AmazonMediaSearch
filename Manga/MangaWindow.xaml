<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="漫画シリーズ情報"
    Width="1000"
    Height="700"
    MinWidth="800"
    MinHeight="550"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search area -->
        <Border
            Grid.Row="0"
            Padding="12"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="4">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="ASIN"/>

                <TextBox
                    x:Name="AsinBox"
                    Grid.Column="1"
                    Height="30"
                    Padding="6,4"
                    VerticalContentAlignment="Center"/>

                <Button
                    x:Name="SearchButton"
                    Grid.Column="2"
                    Width="100"
                    Height="30"
                    Margin="10,0,0,0"
                    Content="検索"/>

            </Grid>

        </Border>

        <!-- Series summary -->
        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="14"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="4">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="SeriesTitleText"
                    Grid.Row="0"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="作品名"/>

                <TextBlock
                    x:Name="VolumeSummaryText"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    FontSize="16"
                    Text="巻数：-"/>

                <TextBlock
                    x:Name="KUSummaryText"
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    FontSize="16"
                    Text="Kindle Unlimited：-"/>

                <TextBlock
                    x:Name="UnknownSummaryText"
                    Grid.Row="3"
                    Margin="0,6,0,0"
                    Foreground="#666666"
                    Text=""/>

            </Grid>

        </Border>

        <!-- Status -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="2,10,0,8"
            Foreground="#555555"
            Text="ASINを入力して検索してください。"/>

        <!-- Volume list -->
        <DataGrid
            x:Name="VolumesGrid"
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            SelectionMode="Single"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="巻"
                    Binding="{Binding Volume}"
                    Width="60"/>

                <DataGridTextColumn
                    Header="KU"
                    Binding="{Binding KUDisplay}"
                    Width="90"/>

                <DataGridTextColumn
                    Header="価格"
                    Binding="{Binding Price}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="タイトル"
                    Binding="{Binding Title}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="ASIN"
                    Binding="{Binding ASIN}"
                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Request summary -->
        <TextBlock
            x:Name="RequestSummaryText"
            Grid.Row="4"
            Margin="2,8,0,0"
            Foreground="#777777"
            Text=""/>

    </Grid>

</Window>